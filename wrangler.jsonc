{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephryx-security",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "vars": {
    "LEAD_TO": "hello@security.zephryx.in",
    "LEAD_FROM": "Zephryx Security <noreply@mail.zephryx.in>"
  },
  "kv_namespaces": [
    { "binding": "LEADS", "id": "677a4d26c51b4ca0b35a8d3785c6dccf" },
    { "binding": "LEADS_RL", "id": "1513048abd0f4cffa768ee444236d280" }
  ],

  // The public address, pinned here rather than left as dashboard-only state,
  // so the hostname the services site answers on is reproducible from this repo.
  // `custom_domain: true` has Cloudflare own the DNS record and certificate;
  // re-declaring an already-attached domain is a no-op.
  "routes": [
    {
      "pattern": "security.zephryx.in",
      "custom_domain": true
    }
  ],

  // Both of these default to TRUE when absent, and wrangler re-applies that
  // default on every deploy — so switching them off in the dashboard alone
  // gets silently undone by the next push. Stated here so config and
  // dashboard agree and stay agreeing.
  //
  // workers_dev off: this site answers on security.zephryx.in and nowhere else. A
  // second hostname serving identical content is duplicate content.
  //
  // preview_urls on: this is what puts the per-commit and per-branch preview
  // links on a pull request, which is how a change gets eyeballed before it
  // reaches the live domain. Worth keeping.
  "workers_dev": false,
  "preview_urls": true,

  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
